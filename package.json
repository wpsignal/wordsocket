{
  "name": "wpsignal",
  "version": "0.22.0",
  "private": true,
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "make-pot": "wp i18n make-pot . languages/wordsocket.pot --slug=wordsocket --domain=wordsocket",
    "dist": "bash bin/dist.sh",
    "svn": "bash bin/svn.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/e2e/tsconfig.json",
    "lint": "wp-scripts lint-js src",
    "test": "npm run test:php && npm run test:e2e",
    "test:php": "vendor/bin/phpunit",
    "test:e2e": "wp-scripts test-playwright",
    "release": "bash bin/release.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@wordpress/e2e-test-utils-playwright": "^2.0.0",
    "@wordpress/plugins": "^6.26.0",
    "@wordpress/scripts": "^30.0.0"
  },
  "dependencies": {
    "@wordpress/api-fetch": "^7.0.0",
    "@wordpress/components": "^28.0.0",
    "@wordpress/i18n": "^5.0.0",
    "@wordpress/ui": "^0.10.0",
    "y-protocols": "^1.0.7"
  },
  "engines": {
    "node": ">=22.19.0",
    "npm": "^10"
  }
}
